<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Blazor Studio Agent: Windows-Dienst auf dem IIS-Server. Stellt eine REST-API für Blazor Studio
    und Build-Pipelines bereit (App-Pools, Sites, Auslastung, Deployments mit Versionen und Rollback).
    Wird von build-installer.ps1 als eigenständiges win-x64-Paket (BlazorStudio-Agent-<Version>.zip) gebaut.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorStudio.Agent</RootNamespace>
    <AssemblyName>BlazorStudio.Agent</AssemblyName>
    <Product>Blazor Studio Agent</Product>
    <Company>Blazor Studio</Company>
    <Copyright>© 2026 Blazor Studio</Copyright>
    <Version>1.6.3</Version>
    <ApplicationIcon>..\..\branding\logo.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorStudio.Deploy\BlazorStudio.Deploy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\*.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="..\BlazorStudio.Deploy\Scripts\Deploy-BlazorStudio.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Deploy-BlazorStudio.ps1" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
