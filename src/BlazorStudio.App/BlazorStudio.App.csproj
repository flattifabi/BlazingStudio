<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BlazorStudio.App</RootNamespace>
    <AssemblyName>BlazorStudio</AssemblyName>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <Product>Blazor Studio</Product>
    <AssemblyTitle>Blazor Studio</AssemblyTitle>
    <Company>Blazor Studio</Company>
    <Copyright>© 2026 Blazor Studio</Copyright>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorStudio.Core\BlazorStudio.Core.csproj" />
    <ProjectReference Include="..\BlazorStudio.Deploy\BlazorStudio.Deploy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
