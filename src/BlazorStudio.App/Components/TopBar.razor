@inherits StudioComponent
@inject IHostBridge Host

@* Kopfbereich in drei Zeilen: Marke (Logo, Projekt, Befehle/Meldungen/Profil) · Menü · Werkzeugleiste (Build/Start/Bereitstellen). *@
<header class="top">
    <div class="brandbar">
        <img class="brand-logo @(Settings.Current.BrandLogo is { Length: > 0 } ? "custom" : "")" src="@LogoSrc" alt="" title="@BrandName" />
        <b class="brand-app ellipsis">@(Ws.Solution?.Name ?? Ws.Project?.Name ?? BrandName)</b>
        <span class="grow"></span>
        <button class="ibtn" title="@L["cmd.commands"] (Ctrl+K)" @onclick='() => Ui.OpenCommandPalette(Ws.HasProject ? "" : ">")'><Icon Name="grid" /></button>
        <button class="ibtn" title="@L["bottom.problems"]" disabled="@(!Ws.HasProject)" @onclick="() => BottomPanel.Show?.Invoke(BottomTab.Problems)">
            <Icon Name="bell" />
            @if (Run.ErrorCount + Run.WarningCount > 0) { <i class="nbadge @(Run.ErrorCount > 0 ? "err" : "")">@(Run.ErrorCount + Run.WarningCount > 99 ? "99+" : Run.ErrorCount + Run.WarningCount)</i> }
        </button>
        <button class="ibtn @(_themePop ? "on" : "")" title="@L["top.appearance"]" @onclick="() => _themePop = !_themePop"><Icon Name="user" /></button>
    </div>

    <div class="menurow">
        <MenuBar />
        <span class="grow"></span>
        <span class="brand-name">@BrandName</span>
        <span class="brand-ver">@Version</span>
    </div>

    <div class="toolbar">
        <button class="tsel proj" title="@(Ws.Project?.RootDirectory ?? L["cmd.openProject"])" @onclick="() => _projMenu = !_projMenu">
            <Icon Name="folder" />
            <span class="ellipsis">@(Ws.Project?.Name ?? Ws.Solution?.Name ?? L["cmd.openProject"])</span>
            <Icon Name="chevd" Class="cv" />
        </button>
        @if (Ws.HasProject)
        {
            <span class="tsep"></span>
            <button class="ibtn" title="@L["cmd.saveAll"] (Ctrl+Shift+S)" disabled="@(!Dirty)" @onclick='() => Run_("file.saveAll")'><Icon Name="save" /></button>
            <button class="ibtn" title="@L["cmd.rescan"]" @onclick='() => Run_("file.rescan")'><Icon Name="refresh" /></button>
            <button class="ibtn" title="@L["cmd.undo"] (Ctrl+Z)" @onclick='() => Run_("edit.undo")'><Icon Name="undo" /></button>
            <button class="ibtn" title="@L["cmd.redo"] (Ctrl+Y)" @onclick='() => Run_("edit.redo")'><Icon Name="redo" /></button>
        }

        <span class="grow"></span>

        @if (Ws.Project?.ProjectFile is not null)
        {
            <button class="tsel" title="@L["top.configuration"]" @onclick="ConfigMenu">
                <span>@Settings.Current.BuildConfiguration</span><Icon Name="chevd" Class="cv" />
            </button>
            <button class="tsel" title="@L["dev.title"]" disabled="@(Ws.Active?.Doc is null)" @onclick="DeviceMenu">
                <span>@DeviceLabel · Web</span><Icon Name="chevd" Class="cv" />
            </button>

            @if (Debug.IsActive)
            {
                <div class="runpill">
                    <span class="dot dbg"></span>
                    <span>@(Debug.IsStopped ? L["run.paused"] : L["run.debugging"])</span>
                    @if (Run.Url is not null) { <a @onclick="OpenBrowser">@ShortUrl</a> }
                    <button class="ibtn" title="@L["cmd.restart"]" @onclick='() => Run_("run.restart")'><Icon Name="restart" /></button>
                    <button class="ibtn danger" title="@L["cmd.stop"] (Shift+F5)" @onclick='() => Run_("run.stop")'><Icon Name="stop" /></button>
                </div>
            }
            else if (Run.State == RunState.Building)
            {
                <div class="runpill"><span class="dot busy"></span><span>@L["run.building"]</span>
                    <button class="ibtn danger" title="@L["cmd.stop"]" @onclick='() => Run_("run.stop")'><Icon Name="stop" /></button>
                </div>
            }
            else if (Run.State == RunState.Running)
            {
                <div class="runpill">
                    <span class="dot @(Run.Url is null ? "busy" : "")"></span>
                    @if (Run.Url is not null)
                    {
                        <a title="@L["cmd.openBrowser"]" @onclick="OpenBrowser">@ShortUrl</a><Icon Name="ext" Class="dim" />
                    }
                    else { <span class="muted">@L["run.starting"]</span> }
                    <button class="ibtn" title="@L["cmd.profiler"] (Alt+F2)" @onclick='() => Run_("tools.profiler")'><Icon Name="activity" /></button>
                    <button class="ibtn" title="@L["cmd.restart"]" @onclick='() => Run_("run.restart")'><Icon Name="restart" /></button>
                    <button class="ibtn danger" title="@L["cmd.stop"] (Shift+F5)" @onclick='() => Run_("run.stop")'><Icon Name="stop" /></button>
                </div>
            }
            else
            {
                <button class="btn" title="@L["cmd.build"] (Ctrl+Shift+B)" @onclick='() => Run_("run.build")'><Icon Name="hammer" />@L["top.build"]</button>
                <div class="splitbtn">
                    <button class="btn ac" title="@L["cmd.run"] (Ctrl+F5)" @onclick='() => Run_("run.start")'><Icon Name="play" />@L["run.start"]</button>
                    <button class="btn ac more" title="@L["top.runOptions"]" @onclick="RunMenu"><Icon Name="chevd" /></button>
                </div>
            }
        }

        <span class="grow"></span>

        @if (Ws.HasProject)
        {
            <span class="savestate @(Dirty ? "dirty" : "")">
                @if (Dirty) { <text>● @L["top.unsaved"]</text> } else { <Icon Name="check" />@L["top.saved"] }
            </span>
            @if (Ws.Project?.ProjectFile is not null)
            {
                <button class="btn" @onclick="DeployMenu"><Icon Name="cloudup" />@L["top.deploy"]</button>
            }
        }
    </div>

    @if (_projMenu)
    {
        <div class="click-catcher" @onclick="() => _projMenu = false"></div>
        <div class="pop menu-pop proj-pop">
            <button class="mi" @onclick='() => Run_("file.open")'><Icon Name="folderopen" />@L["cmd.openProject"]<kbd>Ctrl O</kbd></button>
            <button class="mi" @onclick='() => Run_("file.openSolution")'><Icon Name="sln" />@L["cmd.openSolution"]</button>
            <button class="mi" @onclick='() => Run_("file.newProject")'><Icon Name="foldernew" />@L["cmd.newProject"]</button>
            @if (Ws.HasProject)
            {
                <button class="mi" @onclick='() => Run_("file.newComponent")'><Icon Name="filenew" />@L["cmd.newComponent"]<kbd>Ctrl N</kbd></button>
                <button class="mi" @onclick='() => Run_("tools.nuget")'><Icon Name="package" />@L["cmd.nuget"]<kbd>Ctrl Shift N</kbd></button>
                <button class="mi" @onclick='() => Run_("tools.ef")'><Icon Name="database" />@L["cmd.ef"]</button>
                <button class="mi" @onclick='() => Run_("file.reveal")'><Icon Name="folder" />@L["cmd.reveal"]</button>
            }
            @if (Settings.Current.RecentProjects.Count > 0)
            {
                <div class="sep"></div>
                <div class="hdr">@L["welcome.recent"]</div>
                @foreach (var r in Settings.Current.RecentProjects.Take(6))
                {
                    <button class="mi" title="@r" @onclick="() => OpenRecent(r)"><Icon Name="folder" /><span class="ellipsis" style="max-width:260px">@Path.GetFileName(r.TrimEnd('\\'))</span></button>
                }
            }
            @if (Ws.HasProject)
            {
                <div class="sep"></div>
                <button class="mi" @onclick='() => Run_("file.closeProject")'><Icon Name="x" />@L["cmd.closeProject"]</button>
            }
        </div>
    }

    @if (_themePop)
    {
        <div class="click-catcher" @onclick="() => _themePop = false"></div>
        <div class="pop theme-pop">
            <div class="tp-h">@L["theme.mode"]</div>
            <div class="tmodes">
                @foreach (var m in new[] { "light", "dark", "system" })
                {
                    <button class="@(Settings.Current.ThemeMode == m ? "on" : "")" @onclick="() => Shell.SetThemeModeAsync(m)">@L["theme." + m]</button>
                }
            </div>
            <div class="tp-h">@L["theme.accent"]</div>
            <div class="swatches">
                @foreach (var a in Accents)
                {
                    <button class="@(Settings.Current.Accent == a ? "on" : "")" style="background:@a" title="@a" @onclick="() => Shell.SetAccentAsync(a)"></button>
                }
            </div>
            <div class="tp-h">@L["settings.language"]</div>
            <div class="tmodes" style="grid-template-columns:1fr 1fr">
                <button class="@(L.Language == "de" ? "on" : "")" @onclick='() => Shell.SetLanguage("de")'>Deutsch</button>
                <button class="@(L.Language == "en" ? "on" : "")" @onclick='() => Shell.SetLanguage("en")'>English</button>
            </div>
            <button class="btn wide" @onclick='() => { _themePop = false; Ui.OpenOverlay("settings"); }'><Icon Name="gear" />@L["cmd.settings"]</button>
        </div>
    }
</header>

@code {
    [CascadingParameter] public Shell Shell { get; set; } = default!;

    private bool _projMenu;
    private bool _themePop;
    private (string? Path, string Src) _logo;

    public static readonly string[] Accents = { "#e2001a", "#4c8dff", "#14b8a6", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899", "#64748b" };

    private string BrandName => Settings.Current.BrandName is { Length: > 0 } n ? n : "Blazor Studio";

    private static string Version => "v" + UpdateService.CurrentVersion.Split('+')[0];

    private bool Dirty => Ws.Documents.Any(d => d.IsDirty);

    private string ShortUrl => Run.Url?.Replace("https://", "").Replace("http://", "").TrimEnd('/') ?? "";

    private string DeviceLabel => Ws.Active?.DevicePreset switch
    {
        "tablet" => L["dev.tablet"],
        "phone" => L["dev.phone"],
        "custom" when Ws.Active.DeviceWidth > 0 => Ws.Active.DeviceWidth + " px",
        _ => L["dev.desktop"],
    };

    /// <summary>Eigenes Firmenlogo als data-URL (die WebView darf keine lokalen Dateien laden).</summary>
    private string LogoSrc
    {
        get
        {
            var path = Settings.Current.BrandLogo;
            if (string.IsNullOrWhiteSpace(path) || !File.Exists(path)) return "img/logo.svg";
            if (_logo.Path == path) return _logo.Src;
            try
            {
                var mime = Path.GetExtension(path).ToLowerInvariant() switch
                {
                    ".svg" => "image/svg+xml", ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp", _ => "image/png",
                };
                _logo = (path, $"data:{mime};base64,{Convert.ToBase64String(File.ReadAllBytes(path))}");
                return _logo.Src;
            }
            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
            {
                return "img/logo.svg";
            }
        }
    }

    private async Task Run_(string id)
    {
        _projMenu = false;
        await Shell.ExecuteAsync(id);
    }

    private async Task OpenRecent(string folder)
    {
        _projMenu = false;
        await Ws.OpenProjectAsync(folder);
    }

    private void OpenBrowser()
    {
        if (Run.Url is null) return;
        var route = Ws.Active?.Doc?.PageRoute;
        Host.OpenExternal(Run.Url.TrimEnd('/') + (route is not null && !route.Contains('{') ? route : "/"));
    }

    private MenuEntry Cmd(string id, bool @checked = false)
    {
        var c = Shell.Commands.FirstOrDefault(x => x.Id == id);
        return c is null
            ? MenuEntry.Separator
            : new MenuEntry(L[c.LabelKey], c.Icon, () => Shell.ExecuteAsync(id), c.Keys, Disabled: c.Enabled?.Invoke() == false, Checked: @checked);
    }

    private void ConfigMenu(MouseEventArgs e) => Ui.ShowMenu(e.ClientX - 40, e.ClientY + 14, new[] { "Debug", "Release" }.Select(c =>
        MenuEntry.Do(c, c == "Debug" ? "bug" : "rocket", () => { Settings.Current.BuildConfiguration = c; Settings.Save(); })
            with { Checked = Settings.Current.BuildConfiguration == c }));

    private void DeviceMenu(MouseEventArgs e)
    {
        if (Ws.Active is not { } s) return;
        Ui.ShowMenu(e.ClientX - 40, e.ClientY + 14, new[]
        {
            MenuEntry.Do(L["dev.desktop"] + " · Web", "monitor", () => DesignerView.ApplyPreset(s, Ws, "desktop")) with { Checked = s.DevicePreset == "desktop" },
            MenuEntry.Do(L["dev.tablet"] + " · Web", "tablet", () => DesignerView.ApplyPreset(s, Ws, "tablet")) with { Checked = s.DevicePreset == "tablet" },
            MenuEntry.Do(L["dev.phone"] + " · Web", "phone", () => DesignerView.ApplyPreset(s, Ws, "phone")) with { Checked = s.DevicePreset == "phone" },
            MenuEntry.Separator,
            MenuEntry.Do(L["dev.rotate"], "rotate", () => DesignerView.Rotate(s, Ws), disabled: s.DevicePreset is not ("tablet" or "phone")) with { Checked = s.DeviceLandscape },
        });
    }

    private void RunMenu(MouseEventArgs e) => Ui.ShowMenu(e.ClientX - 200, e.ClientY + 14, new[]
    {
        Cmd("run.start"), Cmd("run.startNoHot"), Cmd("run.debug"), MenuEntry.Separator, Cmd("run.browser"), Cmd("tools.profiler"),
    });

    private void DeployMenu(MouseEventArgs e) => Ui.ShowMenu(e.ClientX - 220, e.ClientY + 14, new[]
    {
        Cmd("tools.iisDeploy"), Cmd("deploy.dockerDeploy"), Cmd("run.publish"), MenuEntry.Separator, Cmd("tools.iis"), Cmd("deploy.docker"), Cmd("tools.pipelines"),
    });
}
