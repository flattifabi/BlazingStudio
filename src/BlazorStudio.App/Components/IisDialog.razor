    // Verlauf
    // ==================================================================

    private RenderFragment HistoryTab(IisServerEntry s) => __builder =>
    {
        if (_history is null)
        {
            <div class="ins-empty"><Icon Name="refresh" Class="spin" /></div>
            return;
        }
        if (_history.Count == 0)
        {
            <div class="ins-empty" style="padding-top:50px"><Icon Name="history" /><span>@L["iis.noHistory"]</span></div>
            return;
        }
        <div class="iis-history">
            <table class="ptable iis-table">
                <thead><tr><th style="width:15%">@L["iis.when"]</th><th style="width:13%">@L["iis.status"]</th><th style="width:22%">Site</th><th style="width:22%">@L["iis.version"]</th><th>@L["iis.source"]</th></tr></thead>
                <tbody>
                    @foreach (var h in _history)
                    {
                        var rec = h;
                        <tr class="@(_historyDetail?.Id == rec.Id ? "iis-open" : "")" @onclick="() => ShowHistory(rec)">
                            <td>@Ago(rec.StartedAt)</td>
                            <td><span class="iis-state @StateClass(rec.State.ToString())">@StateText(rec.State.ToString())</span></td>
                            <td>@rec.Site@(rec.AppPath == "/" ? "" : rec.AppPath)</td>
                            <td class="mono">@(rec.PreviousVersion is { } pv ? pv + " → " : "")<b>@rec.Version</b></td>
                            <td><span class="dim">@rec.Source</span>@if (rec.Commit is { Length: > 0 } c) { <span class="chip mono" style="margin-left:6px">@c[..Math.Min(7, c.Length)]</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_historyDetail is { } hd)
            {
                <div class="iis-result">
                    <div class="iis-result-h"><span class="iis-state @StateClass(hd.State.ToString())">@StateText(hd.State.ToString())</span><b>@hd.Site · @hd.Version</b>
                        <span class="dim">@Ago(hd.StartedAt)@(hd.FinishedAt is { } f ? " · " + (f - hd.StartedAt).TotalSeconds.ToString("0.0", CultureInfo.CurrentCulture) + " s" : "")</span>
                        @if (hd.Notes is { Length: > 0 } n) { <span class="dim">· @n</span> }</div>
                    @if (hd.Error is { } err) { <div class="hint warn" style="margin:6px 0"><Icon Name="alert" />@err</div> }
                    <div class="iis-log mono" style="max-height:none">
                        @foreach (var line in hd.Log) { <div class="l-@line.Level"><span class="dim">@line.At.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span> @line.Text</div> }
                    </div>
                </div>
            }
        </div>
    };

    private async Task ShowHistory(DeploymentRecord r)
    {
        if (_selected is null) return;
        try
        {
            _historyDetail = await Iis.Client(_selected).GetDeploymentAsync(r.Id);
        }
        catch (AgentException e)
        {
            _error = e.Message;
        }
    }

    // ==================================================================
    // Server anlegen/bearbeiten
    // ==================================================================

    private sealed class ServerDraft
    {
        public IisServerEntry? Original { get; init; }
        public string Name { get; set; } = "";
        public string Host { get; set; } = "";
        public int Port { get; set; } = AgentDefaults.Port;
        public bool Https { get; set; }
        public string? Environment { get; set; }
        public string? Thumbprint { get; set; }
        public string? ApiKey { get; set; }
        public string? TestResult { get; set; }
        public bool TestOk { get; set; }
        public bool Testing { get; set; }
    }

    private ServerDraft? _editing;

    private void NewServer() => _editing = new ServerDraft();

    private void EditServer(IisServerEntry s) => _editing = new ServerDraft
    {
        Original = s, Name = s.Name, Host = s.Host, Port = s.Port, Https = s.Https, Environment = s.Environment, Thumbprint = s.CertificateThumbprint,
    };

    private string? ValidateDraft(ServerDraft d)
    {
        if (string.IsNullOrWhiteSpace(d.Host)) return L["iis.hostMissing"];
        try { _ = AgentClient.BuildAddress(d.Host, d.Port, d.Https); }
        catch (UriFormatException) { return L["iis.hostInvalid"]; }
        if (d.Original is null && string.IsNullOrWhiteSpace(d.ApiKey)) return L["iis.keyMissing"];
        return null;
    }

    private async Task TestServer(ServerDraft d)
    {
        if (ValidateDraft(d) is { } problem) { d.TestResult = problem; d.TestOk = false; return; }
        d.Testing = true;
        d.TestResult = null;
        StateHasChanged();
        var key = !string.IsNullOrWhiteSpace(d.ApiKey) ? d.ApiKey.Trim() : d.Original is { } o ? IisService.ApiKeyOf(o) ?? string.Empty : "";
        using var client = new AgentClient(AgentClient.BuildAddress(d.Host.Trim(), d.Port, d.Https), key, d.Thumbprint);
        try
        {
            var ping = await client.PingAsync();
            var info = await client.GetInfoAsync();
            d.TestOk = true;
            d.TestResult = L.F("iis.testOk", ping.MachineName, ping.Version, info.IisInstalled ? info.IisVersion ?? "?" : L["iis.noIis"]);
            if (string.IsNullOrWhiteSpace(d.Name)) d.Name = ping.MachineName;
        }
        catch (AgentException e)
        {
            d.TestOk = false;
            d.TestResult = e.IsUnauthorized ? L["iis.testUnauthorized"] : e.IsUnreachable ? L.F("iis.testOffline", e.Message) : e.Message;
        }
        d.Testing = false;
    }

    private void SaveServer(ServerDraft d)
    {
        if (ValidateDraft(d) is { } problem) { d.TestResult = problem; d.TestOk = false; return; }
        var entry = d.Original ?? new IisServerEntry();
        entry.Name = d.Name.Trim();
        entry.Host = d.Host.Trim();
        entry.Port = d.Port <= 0 ? AgentDefaults.Port : d.Port;
        entry.Https = d.Https;
        entry.Environment = string.IsNullOrWhiteSpace(d.Environment) ? null : d.Environment.Trim();
        entry.CertificateThumbprint = string.IsNullOrWhiteSpace(d.Thumbprint) ? null : AgentClient.NormalizeThumbprint(d.Thumbprint);
        Iis.Save(entry, string.IsNullOrWhiteSpace(d.ApiKey) ? null : d.ApiKey.Trim());
        _editing = null;
        Select(entry);
        Ui.ShowToast(L.F("iis.serverSaved", entry.Display), ToastKind.Success, 2000);
    }

    private async Task RemoveServer(ServerDraft d)
    {
        if (d.Original is not { } o) return;
        if (!await Confirm(L.F("iis.removeServerTitle", o.Display), L["iis.removeServerText"], L["action.remove"])) return;
        Iis.Remove(o);
        _editing = null;
        _selected = Iis.Servers.FirstOrDefault();
        Iis.Watched = _selected;
        _ = LoadTabAsync();
    }

    private RenderFragment ServerForm(ServerDraft d) => __builder =>
    {
        <div class="iis-form scroll">
            <h3>@(d.Original is null ? L["iis.addServer"] : L.F("iis.editServerTitle", d.Original.Display))</h3>
            <div class="g2">
                <div class="row2"><label>@L["iis.host"]</label><div class="f"><input class="mono" value="@d.Host" placeholder="web01.firma.local / 10.0.0.11" spellcheck="false" @oninput="e => d.Host = e.Value?.ToString() ?? string.Empty" /></div></div>
                <div class="row2"><label>Port</label><div class="f"><input type="number" min="1" max="65535" value="@d.Port" @onchange="e => d.Port = int.TryParse(e.Value?.ToString(), out var p) ? p : AgentDefaults.Port" /></div></div>
                <div class="row2"><label>@L["iis.displayName"]</label><div class="f"><input value="@d.Name" placeholder="@L["iis.displayNameHint"]" @oninput="e => d.Name = e.Value?.ToString() ?? string.Empty" /></div></div>
                <div class="row2"><label>@L["iis.environment"]</label><div class="f"><input value="@d.Environment" list="iis-envs" placeholder="Test, Staging, Produktion …" @oninput="e => d.Environment = e.Value?.ToString()" /></div>
                    <datalist id="iis-envs">@foreach (var env in Iis.Servers.Select(s => s.Environment).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct()) { <option value="@env"></option> }</datalist></div>
            </div>
            <div class="row2"><label>@L["iis.apiKey"]</label><div class="f"><Icon Name="lock" /><input type="password" class="mono" value="@d.ApiKey" placeholder="@(d.Original is null ? L["iis.apiKeyHint"] : L["iis.unchanged"])" autocomplete="off" @oninput="e => d.ApiKey = e.Value?.ToString()" /></div></div>
            <label class="check"><input type="checkbox" checked="@d.Https" @onchange="e => d.Https = e.Value is true" />HTTPS</label>
            @if (d.Https)
            {
                <div class="row2"><label>@L["iis.thumbprint"]</label><div class="f"><input class="mono" value="@d.Thumbprint" placeholder="@L["iis.thumbprintHint"]" spellcheck="false" @oninput="e => d.Thumbprint = e.Value?.ToString()" /></div></div>
            }
            else
            {
                <div class="hint" style="margin-bottom:8px"><Icon Name="info" />@L["iis.httpHint"]</div>
            }
            @if (d.TestResult is { } tr)
            {
                <div class="hint @(d.TestOk ? "" : "warn")" style="margin:8px 0"><Icon Name="@(d.TestOk ? "checkc" : "alert")" />@tr</div>
            }
            <div class="btns">
                @if (d.Original is not null) { <button class="btn ghost left danger-text" @onclick="() => RemoveServer(d)"><Icon Name="trash" />@L["action.remove"]</button> }
                <button class="btn ghost" @onclick="() => _editing = null">@L["action.cancel"]</button>
                <button class="btn" disabled="@d.Testing" @onclick="() => TestServer(d)">@if (d.Testing) { <Icon Name="refresh" Class="spin" /> } else { <Icon Name="zap" /> }@L["iis.test"]</button>
                <button class="btn ac" @onclick="() => SaveServer(d)"><Icon Name="save" />@L["action.save"]</button>
            </div>
            <div class="iis-install hint"><Icon Name="info" /><span>@L["iis.installHint"] <code>.\install-service.ps1</code> · <a class="iis-link" @onclick="OpenAgentPackage">@L["iis.agentPackage"]</a></span></div>
        </div>
    };
}
