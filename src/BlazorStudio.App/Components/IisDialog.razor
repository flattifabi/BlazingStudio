    private RenderFragment SitesTab(IisServerEntry s) => __builder =>
    {
        <div class="iis-toolbar">
            <div class="f" style="width:240px"><Icon Name="search" /><input placeholder="@L["iis.filter"]" value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" /></div>
            <span class="grow"></span>
            <button class="btn sm" @onclick='() => _newSite = new CreateSiteRequest { Binding = "http://*:8080" }'><Icon Name="plus" />@L["iis.newSite"]</button>
        </div>
        if (_sites is null)
        {
            <div class="ins-empty"><Icon Name="refresh" Class="spin" /></div>
            return;
        }
        <table class="ptable iis-table">
            <thead><tr>
                <th style="width:22%">@L["iis.name"]</th><th style="width:11%">@L["iis.status"]</th><th style="width:27%">@L["iis.bindings"]</th>
                <th style="width:14%">Pool</th><th style="width:15%">@L["iis.activeVersion"]</th><th style="width:11%"></th>
            </tr></thead>
            <tbody>
                @foreach (var x in _sites.Where(x => _filter.Length == 0 || x.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || x.Bindings.Any(b => b.BindingInformation.Contains(_filter, StringComparison.OrdinalIgnoreCase))))
                {
                    var site = x;
                    foreach (var a in site.Applications)
                    {
                        var app = a;
                        var key = site.Name + app.Path;
                        var open = _expandedSite == site.Name && _expandedApp == app.Path;
                        <tr class="@(open ? "iis-open" : "")" @onclick="() => ToggleVersions(site.Name, app.Path)">
                            <td>
                                @if (app.Path == "/") { <b>@site.Name</b><small class="iis-sub">ID @site.Id</small> }
                                else { <span class="iis-subapp">↳ @app.Path</span> }
                            </td>
                            <td>@if (app.Path == "/") { <span class="iis-state @StateClass(site.State)">@StateText(site.State)</span> }</td>
                            <td>
                                @if (app.Path == "/")
                                {
                                    @foreach (var b in site.Bindings)
                                    {
                                        var bind = b;
                                        @if (bind.Url.Length > 0) { <a class="iis-link" title="@bind.BindingInformation" @onclick:stopPropagation="true" @onclick='() => Host.OpenExternal(bind.Url.TrimEnd((char)47) + (app.Path == "/" ? "/" : app.Path))'>@bind.Protocol://@(bind.Host.Length > 0 ? bind.Host : "*"):@bind.Port</a> }
                                        else { <span class="dim">@bind.Protocol @bind.BindingInformation</span> }
                                    }
                                }
                            </td>
                            <td>@app.Pool</td>
                            <td>@if (app.ActiveVersion is { } v) { <span class="chip mono">@v</span> } else { <small class="dim mono" title="@app.PhysicalPath">@ShortPath(app.PhysicalPath)</small> }</td>
                            <td class="iis-actions" @onclick:stopPropagation="true">
                                @if (app.Path == "/")
                                {
                                    @if (site.State == "Started")
                                    {
                                        <button class="ibtn sm danger" title="@L["iis.stop"]" disabled="@_busy" @onclick="() => StopSite(site)"><Icon Name="stop" /></button>
                                    }
                                    else
                                    {
                                        <button class="ibtn sm" title="@L["iis.start"]" disabled="@_busy" @onclick='() => Act(c => c.SiteActionAsync(site.Name, "start"), L.F("iis.startedToast", site.Name))'><Icon Name="play" /></button>
                                    }
                                    @if (app.ActiveVersion is not null) { <button class="ibtn sm" title="@L["iis.rollbackOne"]" disabled="@_busy" @onclick="() => RollbackOne(site.Name, app)"><Icon Name="undo" /></button> }
                                    <button class="ibtn sm" title="@L["iis.deployHere"]" @onclick="() => DeployTo(site.Name, app.Path)"><Icon Name="rocket" /></button>
                                    <button class="ibtn sm danger" title="@L["action.delete"]" disabled="@_busy" @onclick="() => DeleteSite(site)"><Icon Name="trash" /></button>
                                }
                                else
                                {
                                    @if (app.ActiveVersion is not null) { <button class="ibtn sm" title="@L["iis.rollbackOne"]" disabled="@_busy" @onclick="() => RollbackOne(site.Name, app)"><Icon Name="undo" /></button> }
                                    <button class="ibtn sm" title="@L["iis.deployHere"]" @onclick="() => DeployTo(site.Name, app.Path)"><Icon Name="rocket" /></button>
                                }
                            </td>
                        </tr>
                        @if (open)
                        {
                            <tr class="iis-versions-row"><td colspan="6">@VersionsPanel(site.Name, app)</td></tr>
                        }
                    }
                }
            </tbody>
        </table>
