    private CreateSiteRequest? _newSite;

    private async Task CreateSite()
    {
        if (_newSite is not { } r) return;
        if (string.IsNullOrWhiteSpace(r.Name)) { _error = L["iis.nameMissing"]; return; }
        if (!BindingParser.TryParse(r.Binding, out _, out _)) { _error = L["iis.bindingInvalid"]; return; }
        await Act(c => c.CreateSiteAsync(r), L.F("iis.created", r.Name));
        if (_error is null) _newSite = null;
    }

