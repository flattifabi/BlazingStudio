    private static string ShortPath(string p) => p.Length <= 34 ? p : "…" + p[^33..];

    private async Task ToggleVersions(string site, string app)
    {
        if (_expandedSite == site && _expandedApp == app)
        {
            _expandedSite = null;
            _versions = null;
            return;
        }
        _expandedSite = site;
        _expandedApp = app;
        _versions = null;
        await LoadTabAsync(quiet: true);
    }

    private RenderFragment VersionsPanel(string site, SiteApplicationInfo app) => __builder =>
    {
        <div class="iis-versions">
            <div class="iis-versions-h"><Icon Name="history" /><b>@L["iis.versions"]</b><span class="dim">@app.PhysicalPath</span></div>
            @if (_versions is null)
            {
                <div class="dim" style="padding:8px"><Icon Name="refresh" Class="spin" /></div>
            }
            else if (_versions.Count == 0)
            {
                <div class="dim" style="padding:8px">@L["iis.noVersions"]</div>
            }
            else
            {
                @foreach (var v in _versions)
                {
                    var ver = v;
                    <div class="iis-ver @(ver.IsActive ? "active" : "")">
                        <span class="mono"><b>@ver.Version</b></span>
                        @if (ver.IsActive) { <span class="iis-state ok">@L["iis.active"]</span> }
                        else if (ver.IsPrevious) { <span class="iis-state">@L["iis.previous"]</span> }
                        <span class="dim">@Ago(ver.DeployedAt)</span>
                        <span class="dim">@ver.Source</span>
                        @if (ver.Commit is { Length: > 0 } c) { <span class="chip mono" title="@c">@c[..Math.Min(7, c.Length)]</span> }
                        <span class="dim">@Size(ver.SizeBytes) · @ver.Files @L["iis.files"]</span>
                        <span class="grow"></span>
                        @if (!ver.IsActive)
                        {
                            <button class="btn sm @(ver.IsPrevious ? "ac" : "")" disabled="@_busy" @onclick="() => Activate(site, app, ver)"><Icon Name="@(ver.IsPrevious ? "undo" : "play")" />@(ver.IsPrevious ? L["iis.rollback"] : L["iis.activate"])</button>
                            <button class="ibtn sm danger" title="@L["action.delete"]" disabled="@_busy" @onclick="() => DeleteVersion(site, app.Path, ver)"><Icon Name="trash" /></button>
                        }
                    </div>
                }
            }
        </div>
    };

    private async Task Activate(string site, SiteApplicationInfo app, SiteVersion v)
    {
        if (!await Confirm(L.F("iis.activateTitle", v.Version, site + (app.Path == "/" ? "" : app.Path)), L.F("iis.activateText", app.ActiveVersion ?? app.PhysicalPath, app.Pool), L["iis.activate"], danger: false)) return;
        await Act(c => c.ActivateAsync(site, new ActivateRequest { Version = v.Version, AppPath = app.Path }), L.F("iis.activated", v.Version));
    }

    /// <summary>Ein Klick zurück: auf die vorherige Version (sonst die neueste ältere) umschalten.</summary>
    private async Task RollbackOne(string site, SiteApplicationInfo app)
    {
        if (_selected is not { } s) return;
        List<SiteVersion> versions;
        try
        {
            versions = await Iis.Client(s).GetVersionsAsync(site, app.Path);
        }
        catch (AgentException e)
        {
            _error = e.Message;
            return;
        }
        var active = versions.FirstOrDefault(v => v.IsActive);
        var target = versions.FirstOrDefault(v => v.IsPrevious && !v.IsActive)
                     ?? versions.Where(v => !v.IsActive && (active is null || v.DeployedAt < active.DeployedAt)).OrderByDescending(v => v.DeployedAt).FirstOrDefault();
        if (target is null)
        {
            Ui.ShowToast(L["iis.noRollbackTarget"], ToastKind.Warning, 4000);
            return;
        }
        if (!await Confirm(L.F("iis.rollbackTitle", target.Version, site + (app.Path == "/" ? "" : app.Path)), L.F("iis.activateText", app.ActiveVersion ?? app.PhysicalPath, app.Pool), L["iis.rollback"], danger: false)) return;
        await Act(c => c.ActivateAsync(site, new ActivateRequest { Version = target.Version, AppPath = app.Path }), L.F("iis.activated", target.Version));
    }

    private async Task DeleteVersion(string site, string appPath, SiteVersion v)
    {
        if (!await Confirm(L.F("iis.deleteVersionTitle", v.Version), null, L["action.delete"])) return;
        await Act(c => c.DeleteVersionAsync(site, appPath, v.Version), L.F("iis.deleted", v.Version));
    }

    private async Task StopSite(SiteInfo site)
    {
        if (!await Confirm(L.F("iis.stopSiteTitle", site.Name), L["iis.stopSiteText"], L["iis.stop"])) return;
        await Act(c => c.SiteActionAsync(site.Name, "stop"), L.F("iis.stoppedToast", site.Name));
    }

    private async Task DeleteSite(SiteInfo site)
    {
        var r = await Ui.ShowDialogAsync(new DialogRequest
        {
            Title = L.F("iis.deleteSiteTitle", site.Name), Message = L["iis.deleteSiteText"],
            OkText = L["iis.deleteSiteOnly"], AltText = L["iis.deleteSiteFiles"], CancelText = L["action.cancel"], Danger = true,
        });
        if (r == DialogResult.Cancel) return;
        await Act(c => c.DeleteSiteAsync(site.Name, r == DialogResult.Alt), L.F("iis.deleted", site.Name));
    }

