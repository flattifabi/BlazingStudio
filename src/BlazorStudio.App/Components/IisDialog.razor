                <div class="row2"><label>@L["iis.healthUrl"]</label><div class="f"><input class="mono" value="@_profile.HealthUrl" spellcheck="false" placeholder="http://localhost:8080/health" @onchange="e => _profile.HealthUrl = e.Value?.ToString()" /></div>
                    <small class="dim">@L["iis.healthHint"]</small></div>
                <div class="pub-opts">
                    <label class="check"><input type="checkbox" checked="@_profile.Rollback" @onchange="e => _profile.Rollback = e.Value is true" />@L["iis.autoRollback"]</label>
                    <label class="check"><input type="checkbox" checked="@_profile.CreateSite" @onchange="e => _profile.CreateSite = e.Value is true" />@L["iis.createSite"]</label>
                </div>
                @if (_profile.CreateSite)
                {
                    <div class="g2">
                        <div class="row2"><label>@L["iis.binding"]</label><div class="f"><input class="mono" value="@_profile.Binding" placeholder="http://*:8080" spellcheck="false" @onchange="e => _profile.Binding = e.Value?.ToString()" /></div></div>
                        <div class="row2"><label>Pool</label><div class="f"><input value="@_profile.Pool" placeholder="@L["iis.poolAuto"]" spellcheck="false" @onchange="e => _profile.Pool = e.Value?.ToString()" /></div></div>
                    </div>
                }
                <div class="row2"><label>@L["iis.notes"]</label><div class="f"><input value="@_profile.Notes" @onchange="e => _profile.Notes = e.Value?.ToString()" /></div></div>
                <div class="btns" style="justify-content:flex-start">
                    <button class="btn ac" disabled="@(running || _deployProject is null || _targets.Count == 0)" @onclick="StartDeploy"><Icon Name="rocket" />@L["iis.deploy"]</button>
                    <button class="btn ghost" @onclick='() => Ui.OpenOverlay("pipelines")'><Icon Name="pipeline" />@L["iis.asPipeline"]</button>
                </div>
            </div>

            <div class="iis-deploy-status">
                @if (d is null)
                {
                    <div class="ins-empty" style="padding-top:40px"><Icon Name="rocket" /><span>@L["iis.deployEmpty"]</span></div>
                }
                else
                {
                    <h4>@d.Site · <span class="mono">@d.Version</span></h4>
                    <div class="iis-steps">
                        @foreach (var step in new[] { "publish", "zip", "upload", "deploy" })
                        {
                            var idx = Array.IndexOf(new[] { "publish", "zip", "upload", "deploy", "done" }, d.Step);
                            var my = Array.IndexOf(new[] { "publish", "zip", "upload", "deploy" }, step);
                            var cls = d.Finished ? (d.Ok || my < idx ? "done" : "") : my < idx ? "done" : my == idx ? "now" : "";
                            <div class="iis-step @cls">@if (cls == "now") { <Icon Name="refresh" Class="spin" /> } else if (cls == "done") { <Icon Name="check" /> } else { <Icon Name="dot" /> }@L["iis.step." + step]</div>
                        }
                    </div>
                    @if (d.Progress is { } pr && !d.Finished)
                    {
                        <div class="upd-progress"><div class="bar"><i style="width:@((pr * 100).ToString("0", CultureInfo.InvariantCulture))%"></i></div><small class="dim">@d.Server · @Math.Round(pr * 100) %</small></div>
                    }
                    @foreach (var (server, rec) in d.Results)
                    {
                        <div class="iis-result">
                            <div class="iis-result-h"><span class="iis-state @StateClass(rec.State.ToString())">@StateText(rec.State.ToString())</span><b>@server</b>@if (rec.PreviousVersion is { } pv) { <span class="dim">@pv → @rec.Version</span> }</div>
                            <div class="iis-log mono">
                                @foreach (var line in rec.Log.TakeLast(12)) { <div class="l-@line.Level">@line.Text</div> }
                            </div>
                        </div>
                    }
                    @if (d.Finished)
                    {
                        <div class="hint @(d.Ok ? "" : "warn")" style="margin-top:10px"><Icon Name="@(d.Ok ? "checkc" : "alert")" /><span>@(d.Ok ? L.F("iis.deployDone", d.Version, string.Join(", ", d.Results.Select(r => r.Server))) : d.Error)</span></div>
                    }
                    else
                    {
                        <button class="btn sm" style="margin-top:10px" @onclick="() => d.Cancel.Cancel()"><Icon Name="x" />@L["action.cancel"]</button>
                    }
                }
            </div>
        </div>
    };

