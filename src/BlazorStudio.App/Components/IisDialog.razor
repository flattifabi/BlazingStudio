    // ==================================================================
    // Deployment
    // ==================================================================

    private string? _deployProject;
    private IisDeployProfile _profile = new();
    private HashSet<string> _targets = new();
    private string _versionPreview = "";

    private IEnumerable<string> WebProjects =>
        Ws.Solution?.AllProjects.Where(p => p.Project is not null).Select(p => p.Path) ?? (Ws.Project?.ProjectFile is { } f ? new[] { f } : Array.Empty<string>());

    private void InitDeploy()
    {
        _deployProject ??= Ws.StartupItem?.Path ?? Ws.Project?.ProjectFile;
        LoadProfile();
    }

    private void LoadProfile()
    {
        if (_deployProject is null) return;
        _profile = Settings.Current.IisDeployProfiles.TryGetValue(_deployProject, out var p) ? p : new IisDeployProfile { Site = Path.GetFileNameWithoutExtension(_deployProject) };
        _targets = _profile.ServerIds.Where(id => Iis.Servers.Any(s => s.Id == id)).ToHashSet();
        if (_targets.Count == 0 && _selected is not null) _targets.Add(_selected.Id);
        _versionPreview = IisService.ExpandVersion(_profile.VersionTemplate, _deployProject);
    }

    private void Bump(VersionPart part)
    {
        if (_deployProject is null) return;
        if (Actions.SetVersion(_deployProject, ProjectVersion.Bump(Actions.VersionOf(_deployProject), part)))
            _versionPreview = IisService.ExpandVersion(_profile.VersionTemplate, _deployProject);
    }

    private async Task ChangeVersion()
    {
        await Actions.ChangeVersionAsync(_deployProject);
        if (_deployProject is not null) _versionPreview = IisService.ExpandVersion(_profile.VersionTemplate, _deployProject);
    }

    private void DeployTo(string site, string appPath)
    {
        _profile.Site = site;
        _profile.AppPath = appPath;
        _profile.CreateSite = false;
        if (_selected is not null) _targets = new() { _selected.Id };
        SetTab("deploy");
    }

    private void ToggleTarget(string id, bool on)
    {
        if (on) _targets.Add(id);
        else _targets.Remove(id);
    }

    private async Task StartDeploy()
    {
        if (_deployProject is null) return;
        if (string.IsNullOrWhiteSpace(_profile.Site)) { _error = L["iis.siteMissing"]; return; }
        var servers = Iis.Servers.Where(s => _targets.Contains(s.Id)).ToList();
        if (servers.Count == 0) { _error = L["iis.noTargets"]; return; }
        var version = IisService.ExpandVersion(_profile.VersionTemplate, _deployProject);
        if (!VersionStore.IsValidVersion(version)) { _error = L.F("iis.versionInvalid", version); return; }
        var names = string.Join(", ", servers.Select(s => s.Display));
        if (!await Confirm(L.F("iis.deployTitle", Path.GetFileNameWithoutExtension(_deployProject), version), L.F("iis.deployText", _profile.Site + (_profile.AppPath == "/" ? "" : _profile.AppPath), names), L["iis.deploy"], danger: servers.Any(s => (s.Environment ?? string.Empty).Contains("prod", StringComparison.OrdinalIgnoreCase))))
            return;
        _profile.ServerIds = _targets.ToList();
        Settings.Current.IisDeployProfiles[_deployProject] = _profile;
        Settings.Save();
        _error = null;
        BottomPanel.Show?.Invoke(BottomTab.Output);
        Ws.SaveAll();
        var d = await Iis.DeployAsync(_deployProject, _profile, servers, version);
        if (d.Ok) Ui.ShowToast(L.F("iis.deployDone", version, names), ToastKind.Success, 6000);
        else Ui.ShowToast(d.Error ?? L["iis.deployFailed"], ToastKind.Error, 8000);
        _sites = null;
    }

    private RenderFragment DeployTab() => __builder =>
    {
        var d = Iis.CurrentDeployment;
        var running = d is { Finished: false };
        <div class="iis-deploy">
            <div class="iis-deploy-form">
                <div class="row2"><label>@L["iis.project"]</label>
                    <Dropdown Value="@_deployProject" Options='WebProjects.Select(p => new Dropdown.Option(p, Path.GetFileNameWithoutExtension(p), null, "cube"))' ValueChanged="v => { _deployProject = v; LoadProfile(); }" /></div>

                <div class="row2"><label>@L["iis.targets"]</label>
