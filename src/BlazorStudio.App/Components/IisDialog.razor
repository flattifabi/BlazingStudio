@inherits StudioComponent
@inject IisService Iis
@inject IHostBridge Host
@inject IJSRuntime JS
@inject ProjectActions Actions
@using BlazorStudio.Core.Build

<div class="backdrop" style="padding-top:3vh" @onclick="Close">
    <div class="dialog nuget iis" @onclick:stopPropagation="true">
        <div class="ng-head">
            <div class="iic"><Icon Name="server" /></div>
            <div class="t">
                <h2>@L["iis.title"]</h2>
                <small class="dim">@(Iis.Servers.Count == 0 ? L["iis.subtitleEmpty"] : L.F("iis.subtitle", Iis.OnlineCount, Iis.Servers.Count))</small>
            </div>
            <button class="btn ghost sm" title="@L["iis.agentPackageHint"]" @onclick="OpenAgentPackage"><Icon Name="package" />@L["iis.agentPackage"]</button>
            <button class="ibtn" title="@L["nuget.refresh"]" @onclick="RefreshAll"><Icon Name="refresh" Class="@(_refreshing ? "spin" : null)" /></button>
            <button class="ibtn" title="@L["action.close"]" @onclick="Close"><Icon Name="x" /></button>
        </div>

        <div class="iis-body">
            @* ------------------------------ Serverliste ------------------------------ *@
            <div class="iis-servers scroll">
                @foreach (var group in Iis.Servers.GroupBy(s => string.IsNullOrWhiteSpace(s.Environment) ? "" : s.Environment!.Trim()))
                {
                    @if (group.Key.Length > 0) { <div class="iis-group">@group.Key</div> }
                    @foreach (var srv in group)
                    {
                        var s = srv;
                        var st = Iis.Status(s);
                        <div class="iis-srv @(s == _selected && _editing is null ? "on" : "")" @onclick="() => Select(s)" title="@(st.Error ?? s.Address.ToString())">
                            <span class="iis-dot @HealthClass(st.Health)"></span>
                            <div class="ng-main">
                                <b>@s.Display</b>
                                <small>@(st.Health == ServerHealth.Online && st.Info is { } i ? $"{i.MachineName} · CPU {i.CpuPercent:0}% · RAM {Percent(i.MemoryUsedBytes, i.MemoryTotalBytes):0}%" : HealthText(st))</small>
                            </div>
                        </div>
                    }
                }
                <button class="btn dashed wide" style="margin-top:8px" @onclick="NewServer"><Icon Name="plus" />@L["iis.addServer"]</button>
            </div>

            @* ------------------------------ Inhalt ------------------------------ *@
            <div class="iis-main">
                @if (_editing is { } ed)
                {
                    @ServerForm(ed)
                }
                else if (Iis.Servers.Count == 0)
                {
                    <div class="iis-welcome scroll">
                        <div class="iic" style="width:44px;height:44px"><Icon Name="server" /></div>
                        <h3>@L["iis.welcomeTitle"]</h3>
                        <p class="dim">@L["iis.welcomeText"]</p>
                        <ol>
                            <li>@L["iis.step1"] <button class="btn sm" @onclick="OpenAgentPackage"><Icon Name="package" />@L["iis.agentPackage"]</button></li>
                            <li>@L["iis.step2"] <code>.\install-service.ps1</code></li>
                            <li>@L["iis.step3"]</li>
                        </ol>
                        <button class="btn ac" @onclick="NewServer"><Icon Name="plus" />@L["iis.addServer"]</button>
                    </div>
                }
                else if (_selected is { } sel)
                {
                    var st = Iis.Status(sel);
                    <div class="iis-tabs">
                        <div class="seg">
                            @foreach (var t in Tabs)
                            {
                                var tab = t;
                                <button class="@(_tab == tab.Id ? "on" : "")" @onclick="() => SetTab(tab.Id)"><Icon Name="@tab.Icon" />@L["iis.tab." + tab.Id]</button>
                            }
                        </div>
                        <span class="grow"></span>
                        <span class="dim iis-addr">@sel.Address</span>
                        <button class="ibtn sm" title="@L["iis.editServer"]" @onclick="() => EditServer(sel)"><Icon Name="gear" /></button>
                    </div>
                    @if (st.Health is not (ServerHealth.Online or ServerHealth.Checking or ServerHealth.Unknown) && _tab != "deploy")
                    {
                        <div class="banner warn"><Icon Name="alert" /><span>@HealthText(st)@(st.Error is { } err ? ": " + err : "")</span><span class="grow"></span>
                            <button class="btn sm" @onclick="() => EditServer(sel)">@L["iis.editServer"]</button>
                            <button class="btn sm" @onclick="() => Iis.RefreshAsync(sel)"><Icon Name="refresh" />@L["iis.retry"]</button>
                        </div>
                    }
                    @if (_error is { } e)
                    {
                        <div class="banner warn"><Icon Name="alert" /><span>@e</span><span class="grow"></span><button class="ibtn sm" @onclick="() => _error = null"><Icon Name="x" /></button></div>
                    }
                    <div class="iis-content scroll">
                        @switch (_tab)
                        {
                            case "pools": @PoolsTab(sel) break;
                            case "sites": @SitesTab(sel) break;
                            case "deploy": @DeployTab() break;
                            case "history": @HistoryTab(sel) break;
                            default: @OverviewTab(st) break;
                        }
                    </div>
                }
            </div>
        </div>

        @if (_pool is { } pe) { @PoolEditor(pe) }
        @if (_newSite is { } ns) { @SiteEditor(ns) }
    </div>
</div>

@code {
    private static string? _requestedTab;

    /// <summary>Beim nächsten Öffnen diesen Reiter zeigen (z. B. „deploy“ aus dem Projekt-Menü).</summary>
    public static void Request(string? tab) => _requestedTab = tab;

    private sealed record TabDef(string Id, string Icon);

    private static readonly TabDef[] Tabs =
    {
        new("overview", "activity"), new("pools", "layers"), new("sites", "globe"), new("deploy", "rocket"), new("history", "history"),
    };

    private IisServerEntry? _selected;
    private string _tab = "overview";
    private string? _error;
    private bool _refreshing;
    private bool _busy;
    private Timer? _timer;

    // Daten des gewählten Servers
    private List<AppPoolInfo>? _pools;
    private List<SiteInfo>? _sites;
    private List<DeploymentRecord>? _history;
    private DeploymentRecord? _historyDetail;
    private string _filter = "";
    private string? _expandedSite;
    private string _expandedApp = "/";
    private List<SiteVersion>? _versions;

    protected override void OnStudioInitialized()
    {
        Iis.Changed += Refresh;
        _selected = Iis.Servers.FirstOrDefault(s => Iis.Status(s).Health == ServerHealth.Online) ?? Iis.Servers.FirstOrDefault();
        if (_requestedTab is { } t) _tab = t;
        _requestedTab = null;
        Iis.Watched = _selected;
        Iis.SetFastPolling(true);
        InitDeploy();
        _ = LoadTabAsync();
        // Pools/Sites alle 5 s nachladen (CPU/RAM der Arbeitsprozesse, Zustände)
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (_tab is "pools" or "sites" && !_busy && _pool is null && _newSite is null) await LoadTabAsync(quiet: true);
            if (_tab == "history" && _history?.Any(h => !h.IsFinished) == true) await LoadTabAsync(quiet: true);
        }), null, 5000, 5000);
    }

    public override void Dispose()
    {
        Iis.Changed -= Refresh;
        Iis.SetFastPolling(false);
        Iis.Watched = null;
        _timer?.Dispose();
        base.Dispose();
    }

    private void Close()
    {
        if (_pool is not null) { _pool = null; return; }
        if (_newSite is not null) { _newSite = null; return; }
        Ui.CloseOverlay();
    }

    private async Task RefreshAll()
    {
        _refreshing = true;
        await Iis.RefreshAllAsync();
        await LoadTabAsync();
        _refreshing = false;
    }

    private void Select(IisServerEntry s)
    {
        _editing = null;
        if (_selected == s) return;
        _selected = s;
        Iis.Watched = s;
        _pools = null;
        _sites = null;
        _history = null;
        _historyDetail = null;
        _versions = null;
        _expandedSite = null;
        _error = null;
        _ = Iis.RefreshAsync(s);
        _ = LoadTabAsync();
    }

    private void SetTab(string tab)
    {
        _tab = tab;
        _error = null;
        _ = LoadTabAsync();
    }

    private async Task LoadTabAsync(bool quiet = false)
    {
        if (_selected is not { } s) return;
        var client = Iis.Client(s);
        try
        {
            switch (_tab)
            {
                case "pools":
                    _pools = await client.GetPoolsAsync();
                    break;
                case "sites":
                    _sites = await client.GetSitesAsync();
                    if (_expandedSite is not null) _versions = await client.GetVersionsAsync(_expandedSite, _expandedApp);
                    break;
                case "history":
                    _history = await client.GetDeploymentsAsync(null, 100);
                    if (_historyDetail is { } hd) _historyDetail = await client.GetDeploymentAsync(hd.Id);
                    break;
                case "deploy":
                    if (_sites is null && Iis.Status(s).Health == ServerHealth.Online) _sites = await client.GetSitesAsync();
                    break;
            }
            if (!quiet) _error = null;
        }
        catch (AgentException e)
        {
            if (!quiet) _error = e.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Aktion ausführen, Fehler anzeigen, danach neu laden.</summary>
    private async Task Act(Func<AgentClient, Task> action, string? success = null)
    {
        if (_selected is not { } s) return;
        _busy = true;
        _error = null;
        try
        {
            await action(Iis.Client(s));
            if (success is not null) Ui.ShowToast(success, ToastKind.Success, 2400);
        }
        catch (AgentException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
        await LoadTabAsync(quiet: true);
        _ = Iis.RefreshAsync(s);
    }

    private async Task<bool> Confirm(string title, string? text, string ok, bool danger = true) =>
        await Ui.ShowDialogAsync(new DialogRequest { Title = title, Message = text, OkText = ok, CancelText = L["action.cancel"], Danger = danger }) == DialogResult.Ok;

    private void OpenAgentPackage()
    {
        var dir = Path.Combine(AppContext.BaseDirectory, "agent");
        if (Directory.Exists(dir) && Directory.GetFiles(dir, "*.zip").FirstOrDefault() is { } zip) Host.RevealInExplorer(zip);
        else Host.OpenExternal("https://github.com/flattifabi/BlazingStudio/releases/latest");
    }

    // ------------------------------------------------------------------
    // Hilfen
    // ------------------------------------------------------------------

    private static string HealthClass(ServerHealth h) => h switch
    {
        ServerHealth.Online => "ok",
        ServerHealth.Checking or ServerHealth.Unknown => "busy",
        ServerHealth.Unauthorized or ServerHealth.Error => "warn",
        _ => "err",
    };

    private string HealthText(ServerStatus st) => st.Health switch
    {
        ServerHealth.Online => L["iis.h.online"],
        ServerHealth.Checking or ServerHealth.Unknown => L["iis.h.checking"],
        ServerHealth.Unauthorized => L["iis.h.unauthorized"],
        ServerHealth.Offline => L["iis.h.offline"],
        _ => L["iis.h.error"],
    };

    private static double Percent(long used, long total) => total <= 0 ? 0 : used * 100.0 / total;

    private static string Size(long bytes) => IisService.ProfilerSize(bytes);

    private static string StateClass(string state) => state switch
    {
        "Started" or "Running" or "Succeeded" => "ok",
        "Starting" or "Stopping" or "Queued" => "busy",
        "RolledBack" => "warn",
        "Stopped" or "Failed" => "err",
        _ => "",
    };

    private string StateText(string state) => L["iis.state." + state] is var t && t != "iis.state." + state ? t : state;

    private static string Ago(DateTime utc)
    {
        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        return local.Date == DateTime.Today ? local.ToString("HH:mm", CultureInfo.CurrentCulture) : local.ToString("g", CultureInfo.CurrentCulture);
    }

    private static string Uptime(double seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalDays >= 1 ? $"{(int)t.TotalDays} d {t.Hours} h" : t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes} min" : $"{t.Minutes} min";
    }

    // ==================================================================
    // Übersicht
    // ==================================================================

    private RenderFragment OverviewTab(ServerStatus st) => __builder =>
    {
        if (st.Info is not { } i)
        {
            <div class="ins-empty" style="padding-top:60px"><Icon Name="server" /><span>@HealthText(st)</span></div>
            return;
        }
        var memPct = Percent(i.MemoryUsedBytes, i.MemoryTotalBytes);
        var diskPct = Percent(i.DiskTotalBytes - i.DiskFreeBytes, i.DiskTotalBytes);
        <div class="prof-tiles iis-tiles">
            <div class="tile">
                <div class="tile-h"><span>CPU (@i.ProcessorCount)</span><b>@i.CpuPercent.ToString("0", CultureInfo.CurrentCulture) %</b></div>
                <Sparkline Values="i.CpuHistory" Color="#4c8dff" Max="100" />
            </div>
            <div class="tile">
                <div class="tile-h"><span>@L["iis.memory"]</span><b>@memPct.ToString("0", CultureInfo.CurrentCulture) %</b></div>
                <Sparkline Values="i.MemoryHistory" Color="#14b8e6" Max="100" />
                <small class="dim">@Size(i.MemoryUsedBytes) / @Size(i.MemoryTotalBytes)</small>
            </div>
            <div class="tile">
                <div class="tile-h"><span>@L["iis.disk"]</span><b>@diskPct.ToString("0", CultureInfo.CurrentCulture) %</b></div>
                <div class="iis-bar"><i style="width:@(diskPct.ToString("0.#", CultureInfo.InvariantCulture))%" class="@(diskPct > 90 ? "err" : diskPct > 75 ? "warn" : "")"></i></div>
                <small class="dim">@L.F("iis.diskFree", Size(i.DiskFreeBytes), i.DeployRoot)</small>
            </div>
            <div class="tile">
                <div class="tile-h"><span>IIS</span><b class="@(i.IisServiceState == "Running" ? "ok-text" : "err-text")">@(i.IisInstalled ? i.IisVersion ?? "?" : "–")</b></div>
                <small class="dim">@(i.IisInstalled ? L.F("iis.w3svc", i.IisServiceState) : L["iis.noIis"])</small>
            </div>
        </div>
        <div class="iis-facts">
            <div class="card" @onclick='() => SetTab("pools")'><h5>@L["iis.tab.pools"]</h5><div class="iis-big"><b>@i.PoolsStarted</b><span>/ @i.Pools @L["iis.started"]</span></div></div>
            <div class="card" @onclick='() => SetTab("sites")'><h5>@L["iis.tab.sites"]</h5><div class="iis-big"><b>@i.SitesStarted</b><span>/ @i.Sites @L["iis.started"]</span></div></div>
            <div class="card" @onclick='() => SetTab("history")'><h5>@L["iis.deployments"]</h5><div class="iis-big"><b>@i.RunningDeployments</b><span>@L["iis.running"]</span></div></div>
            <div class="card"><h5>@L["iis.machine"]</h5>
                <div class="iis-kv">
                    <span>@L["iis.host"]</span><b>@i.MachineName</b>
                    <span>@L["iis.os"]</span><b>@i.OsVersion</b>
                    <span>@L["iis.uptime"]</span><b>@Uptime(i.UptimeSeconds)</b>
                    <span>Agent</span><b>@i.AgentVersion @if (IsOutdated(i.AgentVersion)) { <span class="chip warnchip" title="@L["iis.agentOutdatedHint"]">@L["iis.agentOutdated"]</span> }</b>
                    <span>@L["iis.keep"]</span><b>@i.KeepVersions</b>
                </div>
            </div>
        </div>
        <div class="dim" style="font-size:11.5px;padding:8px 2px">@L.F("iis.checked", st.Checked?.ToString("T", CultureInfo.CurrentCulture) ?? "–")</div>
    };

    private static bool IsOutdated(string agentVersion) =>
        !string.IsNullOrWhiteSpace(agentVersion) && AgentDefaults.IsOlderThan(agentVersion, UpdateService.CurrentVersion);

    // ==================================================================
    // App-Pools
    // ==================================================================

    private RenderFragment PoolsTab(IisServerEntry s) => __builder =>
    {
        <div class="iis-toolbar">
            <div class="f" style="width:240px"><Icon Name="search" /><input placeholder="@L["iis.filter"]" value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" /></div>
            <span class="grow"></span>
            <button class="btn sm" @onclick="NewPool"><Icon Name="plus" />@L["iis.newPool"]</button>
        </div>
        if (_pools is null)
        {
            <div class="ins-empty"><Icon Name="refresh" Class="spin" /></div>
            return;
        }
        <table class="ptable iis-table">
            <thead><tr>
                <th style="width:24%">@L["iis.name"]</th><th style="width:11%">@L["iis.status"]</th><th style="width:12%">.NET CLR</th>
                <th style="width:16%">@L["iis.identity"]</th><th class="num" style="width:7%">CPU</th><th class="num" style="width:9%">RAM</th>
                <th class="num" style="width:7%" title="@L["iis.requestsHint"]">@L["iis.requests"]</th><th style="width:14%"></th>
            </tr></thead>
            <tbody>
                @foreach (var p in _pools.Where(p => _filter.Length == 0 || p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || p.Applications.Any(a => a.Contains(_filter, StringComparison.OrdinalIgnoreCase))))
                {
                    var pool = p;
                    <tr @ondblclick="() => EditPool(pool)">
                        <td><b>@pool.Name</b><small class="iis-sub">@(pool.Applications.Count == 0 ? L["iis.noApps"] : string.Join(", ", pool.Applications))</small></td>
                        <td><span class="iis-state @StateClass(pool.State)">@StateText(pool.State)</span>@if (pool.WorkerProcesses.Count > 0) { <small class="iis-sub">PID @string.Join(", ", pool.WorkerProcesses.Select(w => w.ProcessId))</small> }</td>
                        <td>@(pool.ManagedRuntimeVersion.Length == 0 ? L["iis.noManaged"] : pool.ManagedRuntimeVersion)<small class="iis-sub">@pool.PipelineMode@(pool.Enable32Bit ? " · 32-Bit" : "")</small></td>
                        <td>@(pool.IdentityType == "SpecificUser" ? pool.UserName : pool.IdentityType)<small class="iis-sub">@pool.StartMode</small></td>
                        <td class="num mono">@(pool.WorkerProcesses.Count == 0 ? "–" : pool.CpuPercent.ToString("0.#", CultureInfo.CurrentCulture) + " %")</td>
                        <td class="num mono">@(pool.WorkerProcesses.Count == 0 ? "–" : Size(pool.WorkingSetBytes))</td>
                        <td class="num mono">@(pool.ActiveRequests?.ToString(CultureInfo.CurrentCulture) ?? "–")</td>
                        <td class="iis-actions">
                            @if (pool.State == "Started")
                            {
                                <button class="ibtn sm" title="@L["iis.recycle"]" disabled="@_busy" @onclick='() => Act(c => c.PoolActionAsync(pool.Name, "recycle"), L.F("iis.recycled", pool.Name))'><Icon Name="restart" /></button>
                                <button class="ibtn sm danger" title="@L["iis.stop"]" disabled="@_busy" @onclick="() => StopPool(pool)"><Icon Name="stop" /></button>
                            }
                            else
                            {
                                <button class="ibtn sm" title="@L["iis.start"]" disabled="@_busy" @onclick='() => Act(c => c.PoolActionAsync(pool.Name, "start"), L.F("iis.startedToast", pool.Name))'><Icon Name="play" /></button>
                            }
                            <button class="ibtn sm" title="@L["iis.edit"]" @onclick="() => EditPool(pool)"><Icon Name="gear" /></button>
                            <button class="ibtn sm danger" title="@L["action.delete"]" disabled="@(_busy || pool.Applications.Count > 0)" @onclick="() => DeletePool(pool)"><Icon Name="trash" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private async Task StopPool(AppPoolInfo p)
    {
        if (p.Applications.Count > 0 && !await Confirm(L.F("iis.stopPoolTitle", p.Name), L.F("iis.stopPoolText", string.Join(", ", p.Applications)), L["iis.stop"])) return;
        await Act(c => c.PoolActionAsync(p.Name, "stop"), L.F("iis.stoppedToast", p.Name));
    }

    private async Task DeletePool(AppPoolInfo p)
    {
        if (!await Confirm(L.F("iis.deletePoolTitle", p.Name), null, L["action.delete"])) return;
        await Act(c => c.DeletePoolAsync(p.Name), L.F("iis.deleted", p.Name));
    }

    // ---------------- Pool-Editor ----------------

    private PoolSettings? _pool;
    private bool _poolCreate;

    private void NewPool()
    {
        _poolCreate = true;
        _pool = new PoolSettings { Name = "", ManagedRuntimeVersion = "", PipelineMode = "Integrated", IdentityType = "ApplicationPoolIdentity", StartMode = "OnDemand", AutoStart = true, Enable32Bit = false, IdleTimeoutMinutes = 20, RecycleMinutes = 1740, QueueLength = 1000, CpuLimitPercent = 0 };
    }

    private void EditPool(AppPoolInfo p)
    {
        _poolCreate = false;
        _pool = PoolSettings.From(p);
    }

    private async Task SavePool()
    {
        if (_pool is not { } p) return;
        if (string.IsNullOrWhiteSpace(p.Name)) { _error = L["iis.nameMissing"]; return; }
        var create = _poolCreate;
        await Act(c => create ? c.CreatePoolAsync(p) : c.UpdatePoolAsync(p), L.F(create ? "iis.created" : "iis.saved", p.Name));
        if (_error is null) _pool = null;
    }

    private RenderFragment PoolEditor(PoolSettings p) => __builder =>
    {
        <div class="iis-sheet-back" @onclick="() => _pool = null">
            <div class="iis-sheet" @onclick:stopPropagation="true">
                <h3><Icon Name="layers" />@(_poolCreate ? L["iis.newPool"] : L.F("iis.editPool", p.Name))</h3>
                @if (_error is { } e) { <div class="hint warn" style="margin-bottom:10px"><Icon Name="alert" />@e</div> }
                <div class="g2">
                    <div class="row2"><label>@L["iis.name"]</label><div class="f"><input value="@p.Name" disabled="@(!_poolCreate)" spellcheck="false" @onchange="e => p.Name = e.Value?.ToString()?.Trim() ?? string.Empty" /></div></div>
                    <div class="row2"><label>.NET CLR</label>
                        <Dropdown Value="@p.ManagedRuntimeVersion" Options='new[] { new Dropdown.Option("", L["iis.noManaged"], "ASP.NET Core"), new Dropdown.Option("v4.0", "v4.0", ".NET Framework 4.x"), new Dropdown.Option("v2.0", "v2.0", ".NET Framework 2/3.5") }' ValueChanged="v => p.ManagedRuntimeVersion = v ?? string.Empty" /></div>
                    <div class="row2"><label>@L["iis.pipeline"]</label>
                        <div class="seg fill"><button class="@(p.PipelineMode == "Integrated" ? "on" : "")" @onclick='() => p.PipelineMode = "Integrated"'>Integrated</button><button class="@(p.PipelineMode == "Classic" ? "on" : "")" @onclick='() => p.PipelineMode = "Classic"'>Classic</button></div></div>
                    <div class="row2"><label>@L["iis.startMode"]</label>
                        <div class="seg fill"><button class="@(p.StartMode == "OnDemand" ? "on" : "")" @onclick='() => p.StartMode = "OnDemand"'>OnDemand</button><button class="@(p.StartMode == "AlwaysRunning" ? "on" : "")" @onclick='() => p.StartMode = "AlwaysRunning"'>AlwaysRunning</button></div></div>
                    <div class="row2"><label>@L["iis.identity"]</label>
                        <Dropdown Value="@p.IdentityType" Options='new[] { "ApplicationPoolIdentity", "NetworkService", "LocalService", "LocalSystem", "SpecificUser" }.Select(x => new Dropdown.Option(x, x == "SpecificUser" ? L["iis.specificUser"] : x))' ValueChanged="v => p.IdentityType = v" /></div>
                    <div class="row2"><label>@L["iis.idle"]</label><div class="f"><input type="number" min="0" value="@p.IdleTimeoutMinutes" @onchange="e => p.IdleTimeoutMinutes = Int(e)" /><span class="u">min</span></div></div>
                    @if (p.IdentityType == "SpecificUser")
                    {
                        <div class="row2"><label>@L["iis.user"]</label><div class="f"><input value="@p.UserName" placeholder="DOMAIN\user" spellcheck="false" @onchange="e => p.UserName = e.Value?.ToString()" /></div></div>
                        <div class="row2"><label>@L["iis.password"]</label><div class="f"><input type="password" placeholder="@(_poolCreate ? "" : L["iis.unchanged"])" @onchange="e => p.Password = e.Value?.ToString()" /></div></div>
                    }
                    <div class="row2"><label>@L["iis.recycleEvery"]</label><div class="f"><input type="number" min="0" value="@p.RecycleMinutes" @onchange="e => p.RecycleMinutes = Int(e)" /><span class="u">min</span></div></div>
                    <div class="row2"><label>@L["iis.queue"]</label><div class="f"><input type="number" min="10" value="@p.QueueLength" @onchange="e => p.QueueLength = Int(e)" /></div></div>
                    <div class="row2"><label>@L["iis.cpuLimit"]</label><div class="f"><input type="number" min="0" max="100" value="@p.CpuLimitPercent" @onchange="e => p.CpuLimitPercent = double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.CurrentCulture, out var d) ? d : 0" /><span class="u">%</span></div></div>
                </div>
                <div class="pub-opts">
                    <label class="check"><input type="checkbox" checked="@(p.AutoStart == true)" @onchange="e => p.AutoStart = e.Value is true" />@L["iis.autoStart"]</label>
                    <label class="check"><input type="checkbox" checked="@(p.Enable32Bit == true)" @onchange="e => p.Enable32Bit = e.Value is true" />@L["iis.enable32"]</label>
                </div>
                <div class="btns">
                    <button class="btn ghost" @onclick="() => _pool = null">@L["action.cancel"]</button>
                    <button class="btn ac" disabled="@_busy" @onclick="SavePool"><Icon Name="save" />@(_poolCreate ? L["action.create"] : L["action.save"])</button>
                </div>
            </div>
        </div>
    };

    private static int Int(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0;

