                        <small class="dim">→ <span class="mono">@_versionPreview</span> · {version} {date} {time} {user}</small></div>
                    <div class="row2"><label>@L["pub.configuration"]</label>
                        <div class="seg fill"><button class="@(_profile.Configuration == "Release" ? "on" : "")" @onclick='() => _profile.Configuration = "Release"'>Release</button><button class="@(_profile.Configuration == "Debug" ? "on" : "")" @onclick='() => _profile.Configuration = "Debug"'>Debug</button></div></div>
                    <div class="row2"><label>@L["pub.runtime"]</label>
                        <Dropdown Value="@_profile.RuntimeIdentifier" Placeholder="@L["pub.portable"]" Mono="true" Options='new[] { "win-x64", "win-x86", "win-arm64" }.Select(r => new Dropdown.Option(r, r)).Prepend(new Dropdown.Option(null, L["pub.portable"]))' ValueChanged="v => _profile.RuntimeIdentifier = v" /></div>
                    <div class="row2"><label>@L["pub.mode"]</label>
                        <div class="seg fill">
                            <button class="@(!_profile.SelfContained ? "on" : "")" title="@L["pub.fddHint"]" @onclick="() => _profile.SelfContained = false">@L["pub.fdd"]</button>
                            <button class="@(_profile.SelfContained ? "on" : "")" disabled="@(_profile.RuntimeIdentifier is null)" title="@L["pub.scdHint"]" @onclick="() => _profile.SelfContained = true">@L["pub.scd"]</button>
