@* Werkzeugleiste ganz links: oben die Ansichten der linken Spalte und Werkzeuge, unten Hilfe und Einstellungen. *@
@inherits StudioComponent
@inject GitService Git

<nav class="strip">
    <button class="@(IsLeft("explorer") ? "on" : "")" title="@L["left.explorer"]" @onclick='() => LeftPanel.Show(Settings, "explorer", toggle: true)'><Icon Name="folder" /></button>
    <button class="@(IsLeft("components") ? "on" : "")" title="@L["left.components"] (Ctrl+Alt+X)" @onclick='() => LeftPanel.Show(Settings, "components", toggle: true)'><Icon Name="cube" /></button>
    <button class="@(IsOn(BottomTab.Find) ? "on" : "")" title="@L["find.title"] (Ctrl+Shift+F)" @onclick="() => { if (IsOn(BottomTab.Find)) Shell.ToggleBottom(); else FindPanel.Request(); }"><Icon Name="search" /></button>
    <button class="@(IsOn(BottomTab.Git) ? "on" : "")" title="Git (Alt+0)" @onclick='() => ToggleGit("changes")'>
        <Icon Name="sitemap" />
        @if (Git.Status.Changes.Count > 0) { <i class="badge">@(Git.Status.Changes.Count > 99 ? "99+" : Git.Status.Changes.Count)</i> }
    </button>
    <button class="@(IsOn(BottomTab.Debug) ? "on" : "")" title="@L["bottom.debug"]" @onclick="() => Toggle(BottomTab.Debug)">
        <Icon Name="bug" />
        @if (Debug.IsStopped) { <i class="dot warn"></i> }
    </button>
    <button class="@(IsOn(BottomTab.NuGet) ? "on" : "")" title="NuGet" @onclick="() => Toggle(BottomTab.NuGet)"><Icon Name="package" /></button>
    <button class="@(IsLeft("claude") ? "on" : "")" title="Claude" @onclick='() => LeftPanel.Show(Settings, "claude", toggle: true)'><Icon Name="sparkle" /></button>

    <span class="grow"></span>

    <button class="@(IsOn(BottomTab.Terminal) ? "on" : "")" title="@L["bottom.terminal"] (Alt+F12)" @onclick="() => Toggle(BottomTab.Terminal)"><Icon Name="terminal" /></button>
    <button title="@L["cmd.helpShortcuts"]" @onclick='() => Shell.ExecuteAsync("help.shortcuts")'><Icon Name="help" /></button>
    <button title="@L["cmd.settings"] (Ctrl+,)" @onclick='() => Ui.OpenOverlay("settings")'><Icon Name="gear" /></button>
</nav>

@code {
    [CascadingParameter] public Shell Shell { get; set; } = default!;

    protected override void OnStudioInitialized()
    {
        Git.Changed += Refresh;
        BottomPanel.TabChanged += Refresh;
        GitPanel.ViewChanged += Refresh;
        _ = Git.RefreshAsync();
    }

    private bool IsLeft(string view) => !Settings.Current.ToolboxCollapsed && (Settings.Current.LeftPanel == view || (view == "components" && Settings.Current.LeftPanel is not ("explorer" or "claude")));

    private bool IsOn(BottomTab t) => BottomPanel.Current == t && !Settings.Current.BottomCollapsed;

    /// <summary>Wie in Rider: Klick auf das aktive Werkzeug klappt das Panel ein.</summary>
    private void Toggle(BottomTab t)
    {
        if (IsOn(t)) Shell.ToggleBottom();
        else BottomPanel.Show?.Invoke(t);
    }

    private void ToggleGit(string view)
    {
        if (IsOn(BottomTab.Git)) { Shell.ToggleBottom(); return; }
        GitPanel.Request(view);
        BottomPanel.Show?.Invoke(BottomTab.Git);
    }

    public override void Dispose()
    {
        base.Dispose();
        Git.Changed -= Refresh;
        BottomPanel.TabChanged -= Refresh;
        GitPanel.ViewChanged -= Refresh;
    }
}
