@* Rechte Spalte: Ebenen (Struktur der Seite) oben, Eigenschaften/Ereignisse des gewählten Elements darunter. *@
@implements IDisposable
@inject Workspace Ws
@inject Localizer L

<aside class="side">
    <div class="split-x" data-splitter="side" style="left:-3px;width:6px"></div>
    <section class="island">
        <div class="ph">
            <b>@L["side.layers"]</b>
            <span class="grow"></span>
            @if (Ws.Active?.Doc is { } doc) { <span class="dim">@L.F("side.elements", Count(doc.Root) - 1)</span> }
        </div>
        <LayersTree />
    </section>
    <div class="vsplit" data-splitter="layers"></div>
    <section class="island">
        <InspectorPanel />
    </section>
</aside>

@code {
    protected override void OnInitialized() => Ws.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private static int Count(BlazorStudio.Core.Model.DesignNode n) => 1 + n.Children.Sum(Count);

    public void Dispose() => Ws.Changed -= Refresh;
}
